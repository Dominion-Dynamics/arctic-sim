#!/usr/bin/env python3
"""arctic — manage simulation sites.

    ./arctic add fort_ross --bbox "72°00'08.59\"N 94°54'35.12\"W,
                                   72°00'57.85\"N 94°44'57.83\"W,
                                   71°58'05.99\"N 94°54'17.78\"W,
                                   71°58'51.79\"N 94°43'32.23\"W"
    ./arctic add pond_inlet 72.6989 -77.9647 --extent 5000
    ./arctic list
    ./arctic fly fort_ross          # build if needed, start, open the browser
    ./arctic use pond_inlet         # switch the running sim
    ./arctic rm pond_inlet

Coordinates may be decimal degrees or DMS — paste them straight off a map.
Host-side only: the standard library plus docker compose.
"""

from __future__ import annotations

import argparse
import json
import math
import os
import re
import subprocess
import sys
import webbrowser
from pathlib import Path

REPO = Path(__file__).resolve().parent
VALID_GRIDS = [65, 129, 257, 513, 1025, 2049]
NATIVE_M = 10.0  # ArcticDEM posting


# --------------------------------------------------------------------------
# coordinates
# --------------------------------------------------------------------------
DMS = re.compile(
    r"""(?P<deg>-?\d+(?:\.\d+)?)\s*(?:°|d|:|\s)\s*
        (?:(?P<min>\d+(?:\.\d+)?)\s*(?:'|m|:|\s)\s*)?
        (?:(?P<sec>\d+(?:\.\d+)?)\s*(?:"|s|)\s*)?
        (?P<hemi>[NSEW])?""",
    re.X | re.I,
)


def parse_coord(text: str) -> float:
    """Decimal degrees from '72.6989', '-94.82', or '72°00'08.59\"N'."""
    text = text.strip().replace("′", "'").replace("″", '"')
    if re.fullmatch(r"-?\d+(\.\d+)?", text):
        return float(text)
    m = DMS.match(text)
    if not m or m.group("deg") is None:
        raise ValueError(f"cannot parse coordinate: {text!r}")
    val = abs(float(m.group("deg")))
    val += float(m.group("min") or 0) / 60.0
    val += float(m.group("sec") or 0) / 3600.0
    if m.group("deg").startswith("-"):
        val = -val
    hemi = (m.group("hemi") or "").upper()
    if hemi in ("S", "W"):
        val = -val
    return val


def parse_points(text: str) -> list[tuple[float, float]]:
    """Split a blob of pasted coordinates into (lat, lon) pairs."""
    chunks = [c.strip() for c in re.split(r"[;\n]|,(?=\s*\S+\s*[°\d].*[NS])", text)
              if c.strip()]
    if len(chunks) < 2:
        chunks = [c.strip() for c in text.split(",") if c.strip()]
    pts = []
    for chunk in chunks:
        parts = re.findall(r"-?\d[\d°'\"\.\s:]*[NSEW]?", chunk)
        parts = [p for p in (p.strip() for p in parts) if p]
        if len(parts) >= 2:
            pts.append((parse_coord(parts[0]), parse_coord(parts[1])))
        elif len(parts) == 1 and pts and len(pts[-1]) == 1:
            pts[-1] = (pts[-1][0], parse_coord(parts[0]))
    if not pts:
        raise ValueError(f"no coordinate pairs found in {text!r}")
    return pts


def bbox_to_site(pts: list[tuple[float, float]]) -> tuple[float, float, float]:
    """Centre and a square footprint covering all points, with a little margin."""
    lats = [p[0] for p in pts]
    lons = [p[1] for p in pts]
    clat, clon = sum(lats) / len(lats), sum(lons) / len(lons)
    m_lat = (max(lats) - min(lats)) * 111_320.0
    m_lon = (max(lons) - min(lons)) * 111_320.0 * math.cos(math.radians(clat))
    span = max(m_lat, m_lon) * 1.05
    return clat, clon, max(500.0, round(span / 100.0) * 100.0)


def choose_grid(extent: float) -> int:
    """Smallest valid grid that samples at least as finely as the source data."""
    for g in VALID_GRIDS:
        if extent / (g - 1) <= NATIVE_M:
            return g
    return VALID_GRIDS[-1]


# --------------------------------------------------------------------------
# environment / compose
# --------------------------------------------------------------------------
def env_file() -> Path:
    p = REPO / ".env"
    if not p.exists():
        (REPO / ".env.example").exists() and p.write_text(
            (REPO / ".env.example").read_text())
    return p


def read_env() -> dict:
    out = {}
    p = env_file()
    if p.exists():
        for line in p.read_text().splitlines():
            line = line.strip()
            if line and not line.startswith("#") and "=" in line:
                k, v = line.split("=", 1)
                out[k.strip()] = v.strip()
    return out


def set_env(key: str, value: str) -> None:
    p = env_file()
    lines = p.read_text().splitlines() if p.exists() else []
    for i, line in enumerate(lines):
        if re.match(rf"\s*{re.escape(key)}\s*=", line):
            lines[i] = f"{key}={value}"
            break
    else:
        lines.append(f"{key}={value}")
    p.write_text("\n".join(lines) + "\n")


def compose(args: list[str], env: dict | None = None, check: bool = True) -> int:
    sys.stdout.flush()          # keep our messages ahead of the subprocess output
    full = dict(os.environ)
    full.update(env or {})
    r = subprocess.run(["docker", "compose"] + args, cwd=REPO, env=full)
    if check and r.returncode != 0:
        sys.exit(r.returncode)
    return r.returncode


SITES_CONF = REPO / "sites.conf"


def record_site(name: str, lat: float, lon: float, extent: float, grid: int) -> None:
    """Add or update the site in sites.conf so `docker compose up` builds it too."""
    line = f"{name:<13} {lat:>10.6f}  {lon:>11.6f}   {extent:>7.0f}   {grid}"
    lines = SITES_CONF.read_text().splitlines() if SITES_CONF.exists() else []
    for i, existing in enumerate(lines):
        bare = existing.split("#", 1)[0].split()
        if bare and bare[0] == name:
            lines[i] = line
            break
    else:
        lines.append(line)
    SITES_CONF.write_text("\n".join(lines).rstrip() + "\n")
    print(f"  recorded in sites.conf")


def sites() -> list[dict]:
    found = []
    for w in sorted((REPO / "sim" / "worlds").glob("*.world")):
        name = w.stem
        meta = REPO / "out" / name / "terrain.json"
        if meta.exists():
            d = json.loads(meta.read_text())
            found.append({"name": name, **d})
        else:
            found.append({"name": name})
    return found


# --------------------------------------------------------------------------
# commands
# --------------------------------------------------------------------------
def cmd_add(a) -> None:
    if a.bbox:
        pts = parse_points(a.bbox)
        lat, lon, extent = bbox_to_site(pts)
        print(f"  {len(pts)} points -> centre {lat:.6f}, {lon:.6f}")
        if a.extent:
            extent = a.extent
    else:
        if a.lat is None or a.lon is None:
            sys.exit("error: give LAT LON, or --bbox")
        lat, lon = parse_coord(a.lat), parse_coord(a.lon)
        extent = a.extent or 6500.0

    grid = a.grid or choose_grid(extent)
    spacing = extent / (grid - 1)
    print(f"  {a.name}: {lat:.6f}, {lon:.6f}")
    print(f"  {extent:.0f} m square, {grid}^2 grid ({spacing:.2f} m/sample)")
    if lat < 60:
        print("  WARNING: ArcticDEM only covers north of 60°N — this will fail.")

    record_site(a.name, lat, lon, extent, grid)

    env = {"SITE_NAME": a.name, "SITE_LAT": f"{lat:.7f}", "SITE_LON": f"{lon:.7f}",
           "SITE_EXTENT": f"{extent:.0f}", "SITE_GRID": str(grid)}
    if a.force:
        env["FORCE_TERRAIN"] = "1"
    compose(["run", "--rm", "terrain"], env)

    if a.use or a.fly:
        cmd_use(argparse.Namespace(name=a.name, open=a.fly, no_sitl=a.no_sitl))


def cmd_list(_a) -> None:
    found = sites()
    if not found:
        print("no sites yet — try:  ./arctic add <name> <lat> <lon>")
        return
    active = read_env().get("SITE_NAME", "")
    print(f"  {'':2}{'name':<16}{'centre':>24}  {'size':>8} {'grid':>6}  elevation")
    for s in found:
        mark = "*" if s["name"] == active else " "
        if "location" in s:
            print(f"  {mark} {s['name']:<16}"
                  f"{s['location']['lat']:>11.5f},{s['location']['lon']:>11.5f}"
                  f"  {s['extent_m']:>6.0f} m {s['grid']:>5}²"
                  f"  {s['elevation_m']['min']:.0f}–{s['elevation_m']['max']:.0f} m")
        else:
            print(f"  {mark} {s['name']:<16}(no metadata)")
    print("\n  * = active (SITE_NAME in .env)")


def cmd_use(a) -> None:
    if not (REPO / "sim" / "worlds" / f"{a.name}.world").exists():
        print(f"error: no site named {a.name!r}", file=sys.stderr)
        cmd_list(None)
        sys.exit(1)
    set_env("SITE_NAME", a.name)
    # With per-asset containers the fleet's service names come from the
    # roster, so "everything" is the only stable way to name them.
    svcs = ["sim"] if a.no_sitl else []
    compose(["rm", "-sf"] + svcs, check=False)
    compose(["up", "-d"] + svcs, {"SITE_NAME": a.name})
    port = read_env().get("GZWEB_PORT", "8080")
    url = f"http://localhost:{port}"
    print(f"\n  {a.name} is live at {url}")
    print(f"  MAVLink  tcp://localhost:5760   udp://localhost:14550")
    print(f"  Terrain takes ~1-2 min to convert on first view of a new site.")
    if getattr(a, "open", False):
        webbrowser.open(url)


def cmd_fly(a) -> None:
    """Build the site if needed, start everything, open the browser."""
    if not (REPO / "sim" / "worlds" / f"{a.name}.world").exists():
        sys.exit(f"error: {a.name!r} not built yet — ./arctic add {a.name} <lat> <lon>")
    cmd_use(argparse.Namespace(name=a.name, open=True, no_sitl=a.no_sitl))


PROVIDER_KEY = {"maptiler": "MAPTILER_KEY", "mapbox": "MAPBOX_TOKEN",
                "sentinel2": None}


# Everything that defines the scenario rather than the imagery. These are
# forwarded explicitly so swapping provider cannot silently drop the vessel,
# the fog, or the course seed — which is exactly what an earlier version did.
SCENARIO_VARS = [
    "FOG", "FOG_DENSITY", "FOG_COLOUR", "FOG_TYPE",
    "SHIP", "SHIP_MOVING", "SHIP_SPEED", "SHIP_MODEL",
    "COURSE_SEED", "COURSE_LENGTH",
    "PHYSICS_RATE", "TILE_ZOOM",
    "MAPBOX_TOKEN", "MAPTILER_KEY",
]


def cmd_imagery(a) -> None:
    """Re-drape the active site with a different imagery source and reload.

    Preserves the whole scenario: only the imagery source changes.
    """
    env_name = PROVIDER_KEY[a.provider]
    if env_name and not (os.environ.get(env_name) or read_env().get(env_name)):
        sys.exit(f"error: {a.provider} needs {env_name} — export it or put it in .env")

    cfg = read_env()
    name = a.name or cfg.get("SITE_NAME", "fort_ross")

    env = {"IMAGERY_SOURCE": a.provider, "FORCE_TERRAIN": "1",
           "SITE_NAME": name, "IMAGERY_SIZE": str(a.size)}
    carried = []
    for v in SCENARIO_VARS:
        val = os.environ.get(v) or cfg.get(v)
        if val:
            env[v] = val
            if v not in ("MAPBOX_TOKEN", "MAPTILER_KEY"):
                carried.append(f"{v}={val}")

    print(f"  re-draping {name} with {a.provider}")
    if carried:
        print("  carrying over: " + "  ".join(carried))
    compose(["run", "--rm", "terrain"], env)

    set_env("IMAGERY_SOURCE", a.provider)
    # gzweb caches converted assets per world, so the texture swap needs a redeploy.
    compose(["rm", "-sf", "sim"], check=False)
    compose(["up", "-d", "sim"], {"SITE_NAME": name, "GZWEB_REDEPLOY": "1"})
    port = read_env().get("GZWEB_PORT", "8080")
    print(f"\n  {name} on {a.provider} -> http://localhost:{port}")
    print("  hard-refresh the browser; first view re-converts assets (~1-2 min)")


def cmd_verify(a) -> None:
    """Check built worlds against a manifest, so entrants can prove parity."""
    import hashlib
    man = REPO / "competition.lock"
    built = {}
    for s_ in sites():
        n = s_["name"]
        alb = REPO / "out" / n / "albedo.png"
        hm = REPO / "out" / n / "heightmap.png"
        if alb.exists() and hm.exists():
            built[n] = {
                "albedo_sha256": hashlib.sha256(alb.read_bytes()).hexdigest(),
                "heightmap_sha256": hashlib.sha256(hm.read_bytes()).hexdigest(),
            }
    if a.write:
        man.write_text(json.dumps(built, indent=2) + "\n")
        print(f"  wrote {man.name} with {len(built)} site(s)")
        return
    if not man.exists():
        sys.exit("error: no competition.lock — the organiser generates it with "
                 "./arctic verify --write")
    expect = json.loads(man.read_text())
    bad = 0
    for n, want in expect.items():
        got = built.get(n)
        if not got:
            print(f"  {n:<14} MISSING — not built"); bad += 1; continue
        for k in ("heightmap_sha256", "albedo_sha256"):
            if got[k] != want[k]:
                print(f"  {n:<14} MISMATCH {k.replace('_sha256','')}")
                print(f"    expected {want[k][:16]}…  got {got[k][:16]}…")
                bad += 1
                break
        else:
            print(f"  {n:<14} OK")
    sys.exit(1 if bad else 0)


def cmd_rm(a) -> None:
    world = REPO / "sim" / "worlds" / f"{a.name}.world"
    if not world.exists():
        sys.exit(f"error: no site named {a.name!r}")
    import shutil
    world.unlink()
    for d in (REPO / "out" / a.name, REPO / "sim" / "models" / f"terrain_{a.name}"):
        if d.exists():
            shutil.rmtree(d)
    if SITES_CONF.exists():
        keep = [l for l in SITES_CONF.read_text().splitlines()
                if not (l.split("#", 1)[0].split()[:1] == [a.name])]
        SITES_CONF.write_text("\n".join(keep).rstrip() + "\n")
    print(f"removed {a.name} (terrain, world, and sites.conf entry)")


def main() -> None:
    p = argparse.ArgumentParser(
        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = p.add_subparsers(dest="cmd", required=True)

    a = sub.add_parser("add", help="download terrain for a new site")
    a.add_argument("name")
    a.add_argument("lat", nargs="?", help="decimal or DMS")
    a.add_argument("lon", nargs="?", help="decimal or DMS")
    a.add_argument("--bbox", help="pasted corner coordinates; centre and size derived")
    a.add_argument("--extent", type=float, help="metres square (default 6500, or from bbox)")
    a.add_argument("--grid", type=int, choices=VALID_GRIDS,
                   help="heightmap samples/side (default: match source resolution)")
    a.add_argument("--force", action="store_true", help="re-download if it exists")
    a.add_argument("--use", action="store_true", help="switch to it when done")
    a.add_argument("--fly", action="store_true", help="switch to it and open the browser")
    a.add_argument("--no-sitl", action="store_true", help="terrain and viewer only")
    a.set_defaults(func=cmd_add)

    lst = sub.add_parser("list", help="show built sites")
    lst.set_defaults(func=cmd_list)

    u = sub.add_parser("use", help="switch the running sim to a site")
    u.add_argument("name")
    u.add_argument("--open", action="store_true", help="open the browser")
    u.add_argument("--no-sitl", action="store_true")
    u.set_defaults(func=cmd_use)

    f = sub.add_parser("fly", help="start a site and open the browser")
    f.add_argument("name")
    f.add_argument("--no-sitl", action="store_true")
    f.set_defaults(func=cmd_fly)

    im = sub.add_parser("imagery", help="swap the imagery source and reload")
    im.add_argument("provider", choices=sorted(PROVIDER_KEY))
    im.add_argument("--name", help="site (default: active SITE_NAME)")
    im.add_argument("--size", type=int, default=4096, help="texture px")
    im.set_defaults(func=cmd_imagery)

    v = sub.add_parser("verify", help="check builds against competition.lock")
    v.add_argument("--write", action="store_true",
                   help="organiser: record current builds as the reference")
    v.set_defaults(func=cmd_verify)

    r = sub.add_parser("rm", help="delete a site's terrain and world")
    r.add_argument("name")
    r.set_defaults(func=cmd_rm)

    args = p.parse_args()
    args.func(args)


if __name__ == "__main__":
    main()
