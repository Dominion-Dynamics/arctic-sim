    <plugin name="arducopter_plugin" filename="libArduPilotPlugin.so">
      <!-- The world is built on ArcticDEM's EPSG:3413 grid, so world +X is grid
           east and +Y grid north, and the grid is rotated from true north by
           the convergence at this longitude. Upstream assumes X-North/Y-West,
           which put every reported lat/lon 90 deg out plus the convergence.
           This makes the plugin read the world's own <heading_deg>, so each
           site gets its own convergence with nothing to configure. -->
      <worldFrame>ENU</worldFrame>
      <!-- Port settings for the machine running Gazebo -->
      <listen_addr>10.23.0.5</listen_addr>
      <fdm_port_in>9002</fdm_port_in>

      <!-- Port settings for the machine running SITL -->
      <fdm_addr>10.23.0.100</fdm_addr>
      <fdm_port_out>9003</fdm_port_out>
      
      <!--
          Require by APM :
          Only change model and gazebo from XYZ to XY-Z coordinates
      -->
      <modelXYZToAirplaneXForwardZDown>0 0 0 3.141593 0 0</modelXYZToAirplaneXForwardZDown>
      <!-- No <gazeboXYZToNED> here on purpose. <worldFrame>ENU</worldFrame>
           above derives it from the world's own <heading_deg>, which is the
           only way it can be right at more than one site. Re-adding an explicit
           value SILENTLY disables that and restores the rotated-GPS bug: the
           plugin defers to an explicit value. (The stock line was
           "0 0 0 3.141593 0 0"; skywalker_x8 carried a hand-applied 90 deg yaw,
           which was half of this fix -- the axis swap but not the convergence.) -->
      <imuName>iris_demo::iris::iris/imu_link::imu_sensor</imuName>
      <connectionTimeoutMaxCount>5</connectionTimeoutMaxCount>
      <control channel="0">
      <!--
          incoming control command [0, 1]
          so offset it by 0 to get [0, 1]
          and divide max target by 1.
          offset = 0
          multiplier = 838 max rpm / 1 = 838
        -->
        <type>VELOCITY</type>
        <useForce>1</useForce>
        <offset>0</offset>
        <p_gain>0.05</p_gain>
        <i_gain>0</i_gain>
        <d_gain>0</d_gain>
        <i_max>0</i_max>
        <i_min>0</i_min>
        <cmd_max>2.5</cmd_max>
        <cmd_min>-2.5</cmd_min>
        <jointName>iris::rotor_0_joint</jointName>
        <multiplier>838</multiplier>
        <controlVelocitySlowdownSim>1</controlVelocitySlowdownSim>
      </control>
      <control channel="1">
        <type>VELOCITY</type>
        <useForce>1</useForce>
        <offset>0</offset>
        <p_gain>0.05</p_gain>
        <i_gain>0</i_gain>
        <d_gain>0</d_gain>
        <i_max>0</i_max>
        <i_min>0</i_min>
        <cmd_max>2.5</cmd_max>
        <cmd_min>-2.5</cmd_min>
        <jointName>iris::rotor_1_joint</jointName>
        <multiplier>838</multiplier>
        <controlVelocitySlowdownSim>1</controlVelocitySlowdownSim>
      </control>
      <control channel="2">
        <type>VELOCITY</type>
        <useForce>1</useForce>
        <offset>0</offset>
        <p_gain>0.05</p_gain>
        <i_gain>0</i_gain>
        <d_gain>0</d_gain>
        <i_max>0</i_max>
        <i_min>0</i_min>
        <cmd_max>2.5</cmd_max>
        <cmd_min>-2.5</cmd_min>
        <jointName>iris::rotor_2_joint</jointName>
        <multiplier>-838</multiplier>
        <controlVelocitySlowdownSim>1</controlVelocitySlowdownSim>
      </control>
      <control channel="3">
        <type>VELOCITY</type>
        <useForce>1</useForce>
        <offset>0</offset>
        <p_gain>0.05</p_gain>
        <i_gain>0</i_gain>
        <d_gain>0</d_gain>
        <i_max>0</i_max>
        <i_min>0</i_min>
        <cmd_max>2.5</cmd_max>
        <cmd_min>-2.5</cmd_min>
        <jointName>iris::rotor_3_joint</jointName>
        <multiplier>-838</multiplier>
        <controlVelocitySlowdownSim>1</controlVelocitySlowdownSim>
      </control>
    </plugin>

    <!--
      ROS 2 native gimbal control. The companion's gimbal_bridge
      publishes trajectory_msgs/msg/JointTrajectory to
      /set_joint_trajectory; this plugin applies the target position
      directly to gimbal_small_2d::tilt_joint. Bypasses ArduPilot and
      the MAVLink mount path entirely (those caused FDM-side NaN that
      crashed SITL with SIGFPE during init).
    -->
  </model>
</sdf>