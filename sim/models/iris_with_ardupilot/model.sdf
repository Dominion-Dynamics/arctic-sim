    <!-- plugins -->
    <!-- p_gain 0.05 with useForce 1, paired with a 3x rotor inertia in
         iris_with_standoffs — see the note there for why neither the stock
         gain nor a 9x inertia works.
         driving velocity directly removes the rotors' reaction torque, which is
         how a quad gets yaw authority, and snaps all four to speed instantly —
         it armed cleanly but flipped on takeoff (AngErr=174). Rotor inertia about the spin axis is
         1.676e-4, and p_gain 0.20 at a 1/150 s step gives p*dt/I = 7.96 — the
         loop diverges each step and saturates, so all four rotors oscillated
         even at zero throttle. The reaction showed up as yaw-axis gyro noise
         (zgyro swinging +-120 mrad/s while x and y sat at zero), and ArduCopter
         refused to arm with "Gyros inconsistent". Thrust is unaffected: it
         comes from the blades' lift-drag, which depends on blade velocity, and
         that is now exactly the commanded value. -->
    <plugin name="rotor_0_blade_1" filename="libLiftDragPlugin.so">
      <a0>0.3</a0>
      <alpha_stall>1.4</alpha_stall>
      <cla>4.2500</cla>
      <cda>0.10</cda>
      <cma>0.00</cma>
      <cla_stall>-0.025</cla_stall>
      <cda_stall>0.0</cda_stall>
      <cma_stall>0.0</cma_stall>
      <area>0.002</area>
      <air_density>1.2041</air_density>
      <cp>0.084 0 0</cp>
      <forward>0 1 0</forward>
      <upward>0 0 1</upward>
      <link_name>iris::rotor_0</link_name>
    </plugin>
    <plugin name="rotor_0_blade_2" filename="libLiftDragPlugin.so">
      <a0>0.3</a0>
      <alpha_stall>1.4</alpha_stall>
      <cla>4.2500</cla>
