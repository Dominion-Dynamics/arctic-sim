<?xml version='1.0'?>
<sdf version="1.6">
  <model name="iris_demo">
    <include>
      <uri>model://iris_with_standoffs</uri>
    </include>

    <include>
      <uri>model://gimbal_small_2d</uri>
      <!-- Roll 1.9199 rather than 1.5708 aims the camera 20 deg DOWN while
           keeping it dead ahead (azimuth 0.00). Roll is the elevation term
           here, not pitch: the gimbal's own sensor pose (-1.57 -1.57 0) has
           already rotated the optical frame, after which the mount's pitch
           term steers azimuth and its yaw term only spins the image. Verified
           by composing the two rotations — 1.5708 gives elev 0.00, 1.9199
           gives elev -20.00, az unchanged.
           To change the downtilt: elevation_deg = -(roll - 1.5708) in radians,
           so 10 deg down = 1.7453, 30 deg down = 2.0944. Keep
           cfg/quadcopter.yaml's mount_pitch_deg in step or COP's FOV cone will
           point somewhere the camera does not. -->
      <pose>0 -0.01 0.070 1.9199 0 1.57</pose>
    </include>

    <!--
      Gimbal pan (yaw). This joint attaches the gimbal to the drone; its
      axis is 0 0 1 (drone +z / yaw). It was locked (0..0); unlocking it to
      +/-90deg makes it the pan DOF, driven via /set_joint_trajectory by the
      companion's gimbal_bridge. Reusing this existing joint (rather than
      adding a new pan_link) avoids the inertia that crashed SITL before.
    -->
    <joint name="iris_gimbal_mount" type="fixed">
      <parent>iris::base_link</parent>
      <child>gimbal_small_2d::base_link</child>
    </joint>
    
