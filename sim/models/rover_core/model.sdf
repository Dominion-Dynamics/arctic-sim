      <!-- Attitude source for ArduPilotPlugin, and the only sensor it actually
           reads. <imuName> below is matched by Model::SensorScopedName, which
           searches within THIS model, so a bare sensor name is enough and the
           world-side model name — which comes from the roster and is not known
           when this file is written — never enters into it. Only if that
           model-scoped lookup finds nothing does the plugin fall back to a
           world-global name match, which is the path that could pick another
           model's sensor. Naming it distinctly keeps it off that path.

           THE 180 DEG ROLL BELOW IS LOAD-BEARING. Do not "simplify" it away by
           reasoning that modelXYZToAirplaneXForwardZDown already flips the body
           frame — that is exactly the mistake that shipped here once. The two
           rotations are not redundant: the patched plugin's gazeboXYZToNED keeps
           its own 180 deg roll (it only rewrites the YAW from the world heading),
           so attitude = modelPose - gazeboXYZToNED leaves a level vehicle rolled
           180, and the sensor roll plus modelXYZToAirplaneXForwardZDown are what
           cancel it back out. Drop one and ArduPilot reports a level rover at
           roll 179.75 deg, its yaw never aligns, and NavEKF3 eventually takes
           EKFGSF_yaw into a SIGFPE that kills SITL outright.

           Every navigating vehicle here carries it: iris_with_standoffs and
           skywalker_x8 both use this exact pose on their IMU sensor. (The towers
           do not, but they are AntennaTrackers that only pan and tilt and set an
           explicit gazeboXYZToNED, so they are not a counter-example.)

           1000 Hz to match iris_with_standoffs and skywalker_x8; the world steps
           at PHYSICS_RATE and clamps the sensor to it anyway. -->
      <sensor name="rover_imu_sensor" type="imu">
        <pose>0 0 0 3.141593 0 0</pose>
        <always_on>1</always_on>
        <update_rate>1000</update_rate>
        <imu/>
      </sensor>

      <!-- RTK GPS. ArduPilot synthesises its own GPS from the FDM, so nothing in
           the control loop reads this; it is here so the Gazebo side can be
           checked against geodetic truth the way the georeferencing section of
           the README does. stddev is RTK-grade because the real Core is. -->
      <sensor name="rover_gps_sensor" type="gps">
        <always_on>1</always_on>
        <update_rate>5</update_rate>
        <gps>
          <position_sensing>
            <horizontal>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.02</stddev>
              </noise>
            </horizontal>
            <vertical>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.05</stddev>
              </noise>
            </vertical>
          </position_sensing>
        </gps>
      </sensor>
    </link>

    <!-- ================= WHEELS (skid drive) =================
         Four driven cylinders, two per side, commanded as a left group and a
         right group. Right-side joint axes are mirrored (0 -1 0), so their
         multiplier is negated below. -->

    <!-- LEFT FRONT -->
    <link name="lf_wheel_link">
      <pose>0.25 0.25 0.12 0 0 0</pose>
      <inertial>
        <pose>0 0 0 1.5707963 0 0</pose>
        <mass>1.7</mass>
        <inertia>
          <ixx>0.0078342</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.0078342</iyy>
          <iyz>0</iyz>
          <izz>0.012240</izz>
        </inertia>
      </inertial>
      <collision name="collision">
        <pose>0 0 0 1.5707963 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.12</radius>
            <length>0.11</length>
          </cylinder>
        </geometry>
        <surface>
