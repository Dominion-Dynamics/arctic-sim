      </visual>
      <visual name="right_lug_bot_01">
        <pose>-0.1319 -0.2500 -0.0060 0 0 0</pose>
        <geometry>
          <box>
            <size>0.0420 0.1250 0.0180</size>
          </box>
        </geometry>
