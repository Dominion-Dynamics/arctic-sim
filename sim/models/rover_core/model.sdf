      <!-- Tread lugs. Visual only, and parented to THIS link on purpose:
           the wheel joint turns them, so the tread visibly rotates in gzweb
           and in the camera sensors without a plugin or an animated texture.
           A lug at rim angle t sits at (r cos t, 0, r sin t) and is pitched
           by (pi/2 - t) so its thin axis points radially outward. Lugs that
           come round inside the belt plate are simply occluded by it. -->
      <visual name="lug_00">
        <pose>0.1260 0 0.0000 0 1.57080 0</pose>
        <geometry>
          <box>
            <size>0.0420 0.1250 0.0180</size>
          </box>
        </geometry>
        <material>
          <script>
            <uri>model://rover_core/materials/scripts/rover.material</uri>
            <name>Rover/Lug</name>
          </script>
        </material>
      </visual>
