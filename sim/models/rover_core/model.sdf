        <geometry>
          <box>
            <size>0.0420 0.1250 0.0180</size>
          </box>
        </geometry>
        <material>
          <script>
            <uri>model://rover_core/materials/scripts/rover.material</uri>
            <name>Rover/Lug</name>
          </script>
        </material>
      </visual>
      <visual name="right_lug_top_00">
        <pose>-0.1979 -0.2500 0.2460 0 0 0</pose>
        <geometry>
