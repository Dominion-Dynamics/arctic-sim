    </link>
    <joint name="motor_3" type="revolute">
      <parent>base_link</parent>
      <child>rb_wheel_link</child>
      <axis>
        <xyz>0 -1 0</xyz>
        <limit>
          <lower>-1e16</lower>
          <upper>1e16</upper>
        </limit>
        <dynamics>
          <damping>0.0005</damping>
        </dynamics>
      </axis>
    </joint>

    <!-- ================= ArduPilot SITL interface =================
         Endpoints are placeholders. make_world.py rewrites listen_addr,
         fdm_addr, fdm_port_in and fdm_port_out from the roster every build, so
         editing them here has no lasting effect. -->
    <plugin name="ardupilot_plugin" filename="libArduPilotPlugin.so">
      <!-- REQUIRED at this latitude, and the reason is not obvious. The world is
           built on ArcticDEM's EPSG:3413 grid, so +X is grid east and +Y grid
           north, rotated from true north by the grid convergence. worldFrame ENU
           makes the patched plugin (sim/patches/ardupilot_gazebo_worldframe.py)
           derive its NED transform from the world's own <heading_deg>. Without
           it every lat/lon the rover reports is rotated 90 deg plus the
           convergence — and ArduPilot reports arriving at waypoints it is
           hundreds of metres from, so the failure looks like tuning.

           Do NOT add <gazeboXYZToNED> here. The plugin defers to an explicit
           value, which silently switches the above back off. -->
      <worldFrame>ENU</worldFrame>

      <!-- Machine running Gazebo -->
      <listen_addr>10.23.0.5</listen_addr>
      <fdm_port_in>9052</fdm_port_in>

      <!-- Machine running SITL -->
      <fdm_addr>10.23.0.105</fdm_addr>
      <fdm_port_out>9053</fdm_port_out>

      <connectionTimeoutMaxCount>5</connectionTimeoutMaxCount>
      <lock_step>1</lock_step>
      <modelXYZToAirplaneXForwardZDown>0 0 0 3.141593 0 0</modelXYZToAirplaneXForwardZDown>
      <imuName>rover_imu_sensor</imuName>

      <!-- Skid steer. LEFT group on channel 0 (ArduPilot SERVO1, function 73
           ThrottleLeft), RIGHT group on channel 2 (SERVO3, function 74
           ThrottleRight) — matched by sitl/params/rover.parm.

           Drive gain, sized from the real top speed. The Classic plugin gets
           servo output already normalised to 0..1, so 1500 us arrives as 0.5:

             cmd = multiplier * (raw + offset)      [rad/s]

           offset -0.5 puts stop at 0.5 (1500 us) and gives +/-0.5 at the stops.
           Wheel radius 0.12 m for a 0.60 m/s vehicle needs 0.60/0.12 = 5.0
           rad/s, so multiplier = 5.0/0.5 = 10.0.

           cmd_max/cmd_min clamp the PID's OUTPUT, which for VELOCITY control is
           joint torque in N*m — not a velocity. A pivot turn is what sets the
           floor: it drags the wheels sideways against mu 1.1 under 149 N per
           wheel, needing about 1.1 * 149 * 0.12 = 20 N*m each. 50 leaves
           headroom for climbing. iris's +/-2.5 is right for a propeller and
           would leave this rover unable to turn on the spot.

           These gains are derived, not measured — see the tuning note in
           sitl/params/rover.parm. -->
      <control channel="0">
        <type>VELOCITY</type>
        <jointName>motor_0</jointName>
        <useForce>1</useForce>
        <multiplier>10.0</multiplier>
        <offset>-0.5</offset>
        <p_gain>2.5</p_gain>
        <i_gain>1.5</i_gain>
        <d_gain>0.0</d_gain>
        <i_max>25</i_max>
        <i_min>-25</i_min>
        <cmd_max>50</cmd_max>
        <cmd_min>-50</cmd_min>
      </control>
      <control channel="0">
        <type>VELOCITY</type>
        <jointName>motor_1</jointName>
        <useForce>1</useForce>
        <multiplier>10.0</multiplier>
        <offset>-0.5</offset>
        <p_gain>2.5</p_gain>
        <i_gain>1.5</i_gain>
        <d_gain>0.0</d_gain>
        <i_max>25</i_max>
        <i_min>-25</i_min>
        <cmd_max>50</cmd_max>
        <cmd_min>-50</cmd_min>
      </control>

      <!-- multiplier negated: these joints' axes are mirrored (0 -1 0). If a
           forward command pivots the rover instead of driving it, flip the sign
           on one side. -->
      <control channel="2">
        <type>VELOCITY</type>
        <jointName>motor_2</jointName>
        <useForce>1</useForce>
        <multiplier>-10.0</multiplier>
        <offset>-0.5</offset>
        <p_gain>2.5</p_gain>
        <i_gain>1.5</i_gain>
        <d_gain>0.0</d_gain>
        <i_max>25</i_max>
        <i_min>-25</i_min>
        <cmd_max>50</cmd_max>
        <cmd_min>-50</cmd_min>
      </control>
      <control channel="2">
        <type>VELOCITY</type>
        <jointName>motor_3</jointName>
        <useForce>1</useForce>
        <multiplier>-10.0</multiplier>
        <offset>-0.5</offset>
        <p_gain>2.5</p_gain>
        <i_gain>1.5</i_gain>
        <d_gain>0.0</d_gain>
        <i_max>25</i_max>
        <i_min>-25</i_min>
        <cmd_max>50</cmd_max>
        <cmd_min>-50</cmd_min>
      </control>
    </plugin>

  </model>
</sdf>
