<?xml version="1.0"?>
<model>
  <name>rover_core</name>
  <version>1.0</version>
  <sdf version="1.6">model.sdf</sdf>

  <author>
    <name>Nick</name>
    <email>nickaleks@ddc2.com</email>
  </author>

  <description>
    Tracked skid-steer ground rover, driven by ArduPilot ArduRover over
    the FDM. 0.74 x 0.64 x 0.57 m, 60.8 kg, top speed 0.60 m/s. Skid drive on
    plugin channels 0 (left, SERVO1 fn 73) and 2 (right, SERVO3 fn 74); see
    sitl/params/rover.parm. Ported from an upstream Gazebo Sim (SDF 1.9) model —
    the header in model.sdf lists what had to change for Classic.
  </description>
</model>
