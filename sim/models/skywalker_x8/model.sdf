<?xml version="1.0"?>
<!-- Ported from ArduPilot/SITL_Models (Gazebo Sim) to Gazebo Classic 11:
     degrees="true" poses converted to radians, gz-sim-lift-drag-system ->
     libLiftDragPlugin.so, gz-sim apply-joint-force and joint-state-publisher
     dropped, ArduPilotPlugin -> libArduPilotPlugin.so with listen_addr and
     fdm_port_out added and servo_min/servo_max removed (unsupported there).
     Upstream: https://github.com/ArduPilot/SITL_Models -->
<sdf version="1.7">
  <model name="skywalker_x8">
    <pose>0 0 0.246 0 0 0</pose>

    <link name='base_link'>
      <pose>0 0 0 0 0 0</pose>
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>4.5</mass>
        <inertia>
          <ixx>0.45</ixx>
          <ixy>0</ixy>
          <ixz>0.06</ixz>
          <iyy>0.325</iyy>
          <iyz>0</iyz>
          <izz>0.75</izz>
        </inertia>
      </inertial>
      <!-- Three skid contacts instead of one 0.80 x 2.15 x 0.2 box.
           The box was the cause of two visible faults:
             * It only reached z=-0.170, while the model-level <pose> lifts
               base_link by 0.246 — so the aircraft floated 0.076 m above the
               ground. The spheres reach exactly -0.246 and close that gap.
             * A wide flat box puts its corner contacts on different facets of a
               heightmap quantised to 0.99 m vertically and 6.35 m horizontally.
               ODE then rocks between contact sets — the aircraft rolled rapidly
               from wingtip to wingtip about the fuselage. A tripod is
               statically determinate: three points always define one plane, so
               there is no set to alternate between.
           Zero restitution and explicit contact stiffness stop it bouncing. -->
      <collision name="skid_nose">
        <pose> 0.24  0.00 -0.201 0 0 0</pose>
        <geometry><sphere><radius>0.045</radius></sphere></geometry>
        <surface>
          <friction><ode><mu>0.15</mu><mu2>0.15</mu2></ode></friction>
          <contact><ode><min_depth>0.003</min_depth><kp>1e6</kp><kd>100</kd></ode></contact>
          <bounce><restitution_coefficient>0</restitution_coefficient></bounce>
        </surface>
      </collision>
      <collision name="skid_left">
        <pose>-0.22  0.30 -0.201 0 0 0</pose>
        <geometry><sphere><radius>0.045</radius></sphere></geometry>
        <surface>
          <friction><ode><mu>0.15</mu><mu2>0.15</mu2></ode></friction>
          <contact><ode><min_depth>0.003</min_depth><kp>1e6</kp><kd>100</kd></ode></contact>
          <bounce><restitution_coefficient>0</restitution_coefficient></bounce>
        </surface>
      </collision>
      <collision name="skid_right">
        <pose>-0.22 -0.30 -0.201 0 0 0</pose>
        <geometry><sphere><radius>0.045</radius></sphere></geometry>
        <surface>
          <friction><ode><mu>0.15</mu><mu2>0.15</mu2></ode></friction>
          <contact><ode><min_depth>0.003</min_depth><kp>1e6</kp><kd>100</kd></ode></contact>
          <bounce><restitution_coefficient>0</restitution_coefficient></bounce>
        </surface>
      </collision>
      <visual name='base_link_visual'>
        <geometry>
          <mesh>
            <uri>model://skywalker_x8/meshes/x8_wing.dae</uri>
          </mesh>
        </geometry>
        <material>
          <diffuse>1.0 1.0 1.0</diffuse>
          <specular>1.0 1.0 1.0</specular>
          <pbr>
            <metal>
                <albedo_map>model://skywalker_x8/materials/textures/x8.tga</albedo_map>
                <metalness>0.1</metalness>
            </metal>
          </pbr>
        </material>
      </visual>
      <visual name='m4'>
        <pose>-0.361 0 0.0 0.000000 1.570796 0.000000</pose>
        <geometry>
          <cylinder>
            <length>0.035</length>
            <radius>0.02</radius>
          </cylinder>
        </geometry>
        <material>
          <ambient>1 1 1</ambient>
          <diffuse>1 1 1</diffuse>
          <specular>1 1 1</specular>
          <pbr>
            <metal>
              <albedo_map>model://skywalker_x8/materials/textures/blue_metal/blue_metal_basecolor.jpg</albedo_map>
              <metalness_map>model://skywalker_x8/materials/textures/blue_metal/blue_metal_metallic.jpg</metalness_map>
              <normal_map>model://skywalker_x8/materials/textures/blue_metal/blue_metal_normal.jpg</normal_map>
              <roughness_map>model://skywalker_x8/materials/textures/blue_metal/blue_metal_roughness.jpg</roughness_map>
              <roughness>1.0</roughness>
              <metalness>1.0</metalness> 
            </metal>
          </pbr>
        </material>
      </visual>
