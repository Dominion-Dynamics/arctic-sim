    <plugin name="ardupilot_plugin" filename="libArduPilotPlugin.so">
      <!-- The world is built on ArcticDEM's EPSG:3413 grid, so world +X is grid
           east and +Y grid north, and the grid is rotated from true north by
           the convergence at this longitude. Upstream assumes X-North/Y-West,
           which put every reported lat/lon 90 deg out plus the convergence.
           This makes the plugin read the world's own <heading_deg>, so each
           site gets its own convergence with nothing to configure. -->
      <worldFrame>ENU</worldFrame>
      <!-- Port settings -->
      <listen_addr>10.23.0.5</listen_addr>
        <fdm_addr>10.23.0.101</fdm_addr>
      <fdm_port_in>9012</fdm_port_in>
        <fdm_port_out>9013</fdm_port_out>
      <connectionTimeoutMaxCount>5</connectionTimeoutMaxCount>
      <lock_step>1</lock_step>

      <modelXYZToAirplaneXForwardZDown>0 0 0 3.141593 0.000000 0.000000</modelXYZToAirplaneXForwardZDown>
      <!-- No <gazeboXYZToNED> here on purpose. <worldFrame>ENU</worldFrame>
           above derives it from the world's own <heading_deg>, which is the
           only way it can be right at more than one site. Re-adding an explicit
           value SILENTLY disables that and restores the rotated-GPS bug: the
           plugin defers to an explicit value. (The stock line was
           "0 0 0 3.141593 0 0"; skywalker_x8 carried a hand-applied 90 deg yaw,
           which was half of this fix -- the axis swap but not the convergence.) -->

      <!-- Sensors -->
      <imuName>imu_sensor</imuName>

      <!--
          incoming control command [0, 1]
          so offset it by 0 to get [0, 1]
          and divide max target by 1.
          offset = 0
          multiplier = 838 max rpm / 1 = 838
        -->

      <!-- 
          SERVO3_FUNCTION   70 (Throttle)
          SERVO3_MAX        2000
          SERVO3_MIN        1000
          SERVO3_REVERSED   0
          SERVO3_TRIM       1000
       -->
      <control channel="2">
        <jointName>rotor_pusher_joint</jointName>
        <!-- useForce 0 — set the joint velocity directly, no PID:
               force PID. The rotor's inertia about its spin axis is 9.75e-6,
               and a force loop with p_gain 0.2 at a 1/150 s step gives
               p*dt/I = 137 — it diverges every step, saturates on cmd_max and
               flips sign. That was the prop rocking back and forth, and its
               reaction torque was walking the airframe across the ground. The
               elevons keep their force PID: their hinge inertia is 0.0033, some
               340x larger, so that loop is comfortably stable.
               Thrust is unaffected — it comes from the blades' lift-drag, which
               depends on blade velocity, and that is now exactly the commanded
               value rather than an oscillation around it. -->
          <!-- useForce 0: set the joint velocity directly, no force PID. The rotor
               inertia is 9.75e-6 and a force loop at p_gain 0.2 with a 1/150 s
               step gives p*dt/I = 137 — it diverges every step and saturates,
               which is the prop visibly rocking. Detuning p_gain to a stable
               0.001 removes the jitter but starves the prop of thrust, so the
               aircraft will not accelerate. Driving velocity directly gives
               both: exact commanded RPM, no loop to go unstable.
               The axis is left at upstream's 0 0 1 — the blade lift-drag
               geometry is built around that reading in Classic. -->
          <useForce>0</useForce>
        <multiplier>838</multiplier>
        <offset>0</offset>
        <type>VELOCITY</type>
        <p_gain>0.20</p_gain>
        <i_gain>0</i_gain>
        <d_gain>0</d_gain>
        <i_max>0</i_max>
        <i_min>0</i_min>
        <cmd_max>2.5</cmd_max>
        <cmd_min>-2.5</cmd_min>
      </control>

      <!-- 
          SERVO1_FUNCTION   77 (Elevon Left)
          SERVO1_MAX        1900
          SERVO1_MIN        1100
          SERVO1_REVERSED   0
          SERVO1_TRIM       1500

          pwm:          =>  [1100, 1900] 
          input:        =>  [0, 1]
          offset: -0.5  =>  [-0.5, 0.5]
          scale:   2.0  =>  [-1.0, 1.0]
          scale: 0.524  =>  [-0.524, 0.524]
       -->
      <control channel="0">
        <jointName>left_elevon_joint</jointName>
        <useForce>1</useForce>
        <multiplier>1.048</multiplier>
        <offset>-0.5</offset>
        <type>POSITION</type>
        <p_gain>10.0</p_gain>
        <i_gain>0</i_gain>
        <d_gain>0</d_gain>
        <i_max>0</i_max>
        <i_min>0</i_min>
        <cmd_max>2.5</cmd_max>
        <cmd_min>-2.5</cmd_min>
      </control>

      <!-- 
          SERVO2_FUNCTION   78 (Elevon Right)
          SERVO2_MAX        1900
          SERVO2_MIN        1100
          SERVO2_REVERSED   0
          SERVO2_TRIM       1500
       -->
      <control channel="1">
        <jointName>right_elevon_joint</jointName>
        <useForce>1</useForce>
        <multiplier>1.048</multiplier>
        <offset>-0.5</offset>
        <type>POSITION</type>
        <p_gain>10.0</p_gain>
        <i_gain>0</i_gain>
        <d_gain>0</d_gain>
        <i_max>0</i_max>
        <i_min>0</i_min>
        <cmd_max>2.5</cmd_max>
        <cmd_min>-2.5</cmd_min>
      </control>

    </plugin>
  </model>
</sdf>
