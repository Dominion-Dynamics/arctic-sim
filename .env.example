# Copy to .env and edit. Everything downstream keys off these.

# --- Site -------------------------------------------------------------------
# Any land above 60°N works: terrain comes from ArcticDEM, imagery from
# Sentinel-2. Both are fetched on demand for these coordinates.
SITE_NAME=fort_ross
SITE_LAT=71.991960
SITE_LON=-94.822428

# Square footprint in metres of real ground, and heightmap resolution.
# SITE_GRID must be 2^n+1: 513, 1025, 2049. 1025 over 6500 m is ~6.3 m/sample.
SITE_EXTENT=6500
SITE_GRID=1025

# --- Imagery ----------------------------------------------------------------
# Polar night has no light, so only summer months yield usable scenes.
IMAGERY_MONTHS=6,7,8
IMAGERY_CLOUD=5

# Sentinel-2 is 10 m, so a 6.5 km site holds only ~650 px of real optical
# detail. ArcticDEM publishes a 2 m mosaic — 5x finer — and its high-frequency
# hillshade is mixed in to add genuine micro-relief the imagery cannot resolve.
# sentinel2 (free, 10 m) or maptiler (~1.5 m here — run
# terrain/check_maptiler.py to measure your site before trusting a zoom).
# MapTiler requires attribution: "(c) MapTiler (c) OpenStreetMap contributors".
# sentinel2 (free, 10 m) | maptiler | mapbox
# MapTiler and Mapbox both resell the same Maxar basemap — at Bellot Strait both
# resolve to ~1.5 m (z14), 6.8x Sentinel-2. Run terrain/check_tiles.py per site
# before trusting a zoom; coverage tiers vary by location.
# Both REQUIRE visible attribution — see docs/ordering.md.
IMAGERY_SOURCE=mapbox

# >>> PUT YOUR KEY HERE <<<
# Leave this blank and the build still succeeds, but silently drops to
# Sentinel-2: 650 px of real detail across a 6.5 km site instead of 4401,
# upscaled into the same 4096 texture. That is the blurry terrain people
# report. Free tier at https://account.mapbox.com/ — a full build of all
# three sites is ~500 tiles against a 750,000/month allowance.
MAPBOX_TOKEN=

# Only needed if you set IMAGERY_SOURCE=maptiler instead.
MAPTILER_KEY=

TILE_ZOOM=14

IMAGERY_DETAIL=1
IMAGERY_DETAIL_STRENGTH=0.55

# Texture resolution. 4096 is worth it with detail on; drop to 2048 for a much
# smaller download if gzweb is slow to load a site.
IMAGERY_SIZE=4096

# --- Fleet ------------------------------------------------
# One line per asset you control: ASSET_N=type,name,lat,lon
#   type   copter | plane | boat | rover | tower
#   name   MUST be one of the roles declared in
#          docker-compose.yml: quadcopter, fixed-wing, boat,
#          tower-1, tower-2
#   lat,lon  right-click in the sim and copy "lat,lon".
#            Prefix with xy: for world metres. Leave blank
#            to auto-place on suitable ground.
#
# Each role has its own container and its own IP, so every
# asset answers on ArduPilot's stock ports at its address:
#   quadcopter 10.23.0.100   host tcp 5760  udp 14550
#   fixed-wing 10.23.0.101   host tcp 5770  udp 14560
#   boat       10.23.0.102   host tcp 5780  udp 14570
#   tower-1    10.23.0.103   host tcp 5790  udp 14580
#   tower-2    10.23.0.104   host tcp 5800  udp 14590
# The address follows the ROLE, not the ASSET_N number, so
# reordering these lines never moves an asset's endpoint.
# A role with no line here runs an idle container.
#
# Towers are ArduPilot AntennaTracker instances: pan and tilt
# are SERVO1/SERVO2, driven over MAVLink like any other vehicle.
#
# The target vessel is NOT here — it is what teams have to
# find, so it stays under SHIP_* below with no MAVLink endpoint.
ASSET_1=copter,quadcopter,
ASSET_2=tower,tower-1,
# The 5th field is an optional heading: a true bearing in degrees,
# or >lat,lon to face a point (here, lining the wing up with a
# flat stretch that serves as a makeshift airstrip).
# ASSET_3=plane,fixed-wing,71.998195,-94.841967,>71.997790,-94.846245
# ASSET_4=boat,boat,71.999587,-94.845174
# ASSET_5=tower,tower-2,

# --- Vehicle ----------------------------------------------------------------


# Firmwares compiled into the SITL image. Each adds build time; trim if you
# only fly one type.
SITL_VEHICLES=copter rover plane antennatracker

# --- Performance ------------------------------------------------------------
# Gazebo's step rate. Raise it for better fidelity if your machine keeps up.
PHYSICS_RATE=400

# ArduPilot's SCHED_LOOP_RATE. It must be LOWER than PHYSICS_RATE, never equal.
#
# This is the opposite of what you would expect, and setting them equal is the
# single easiest way to end up with a vehicle that will not arm:
#
#   PreArm: Main loop slow (272Hz < 400Hz)
#
# The FDM exchange is a synchronous round trip. SITL sends servo output and
# blocks until the plugin answers, and the plugin only answers on its next
# world step, so every iteration costs one step of waiting plus about a
# millisecond of container networking. SITL therefore lands strictly below the
# world rate no matter how idle the machine is -- measured on a g4dn.2xlarge, a
# 250 Hz world sustains ~205 Hz and a 400 Hz world ~272-326 Hz.
#
# Chasing it by raising PHYSICS_RATE alone never converges, because the
# achieved rate is a fraction of whatever you ask for. Leave headroom instead.
# Unset falls back to PHYSICS_RATE, i.e. the broken equal case.
LOOP_RATE=250

SPEEDUP=1

# ---- Target-----------------------------------------------------------------

# Target vessel: SHIP places one, SHIP_MOVING sends it along a planned course.
SHIP=1
SHIP_MOVING=1
SHIP_SPEED=3.0
# fixed  = always the same start (reproducible)
# random = seeded random start; for a moving vessel this is a point along the
#          already-validated course, so the track never crosses land either way.
# Pin the vessel to an exact spot: paste 'lat,lon' from the right-click picker
# (or 'x,y' in world metres). When set it wins over SHIP_START, and the route is
# planned to begin there. Leave blank to use SHIP_START below.
SHIP_START_AT=

SHIP_START=fixed
SHIP_START_SEED=1
COURSE_SEED=1
COURSE_LENGTH=6000

# --- Weather ----------------------------------------------------------------
# Fog is rendered by Gazebo into CAMERA SENSORS, so it genuinely degrades what a
# drone sees — not just the human view. Visibility is roughly 3/density metres:
#   0.0008 -> ~3.7 km (light haze)   0.0015 -> ~2 km   0.005 -> ~600 m (thick)

FOG=0
FOG_DENSITY=0.0008
FOG_COLOUR=0.80 0.84 0.88
FOG_TYPE=exp2

# --- Ports ------------------------------------------------------------------
GZWEB_PORT=8080
# Control panel (reset / console / .env editor). Loopback only.
CONTROL_PORT=8090

# --- Rebuild switches -------------------------------------------------------
# FORCE_TERRAIN=1   re-download and rebuild terrain even if the world exists
# GZWEB_REDEPLOY=1  re-run gzweb asset conversion on next start


# --- Remote deployment only -------------------------------------------------
# Leave these commented out locally. They belong on a cloud instance (see
# modules/blueprints/arctic-sim/README.md in the infra repo) and are excluded
# from `arctic-push`, so the instance is the only copy -- worth keeping a
# backup if you ever rebuild one.
#
# Always include the GPU overlay. WITHOUT THIS the control panel's rebuild
# button, its reset, and its post-.env-edit recreate all shell out to a bare
# `docker compose`, which reads docker-compose.yml alone and drops
# docker-compose.gpu.yml. gzserver then falls back to Xvfb + llvmpipe, burns
# ~6 cores rasterising cameras, real-time factor drops to ~0.68 and the
# aircraft wobble. Nothing errors; the only tell is that `nvidia-smi` stops
# listing gzserver. Do NOT set it on a laptop: there is no nvidia runtime and
# every compose command fails.
# COMPOSE_FILE=docker-compose.yml:docker-compose.gpu.yml
#
# Interfaces to publish on. 0.0.0.0 for gzweb so it is reachable over both the
# tailnet and the WireGuard tunnel; the control API is pinned to the tunnel
# address because it holds the Docker socket and can rewrite this file, so
# reaching it is equivalent to root on the host.
# SIM_BIND=0.0.0.0
# CONTROL_BIND=10.99.0.1
